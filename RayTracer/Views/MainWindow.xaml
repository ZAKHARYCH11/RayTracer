<Window x:Class="RayTracer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RayTracer.Views"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        mc:Ignorable="d"
        Title="Трассировщик лучей" 
        Width="1280" Height="720" 
        MinWidth="1000" MinHeight="600" 
        FontFamily="Segoe UI"
        Background="#252526">

    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="2">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть сцену" Click="MenuOpenScene_Click"/>
                <MenuItem Header="Сохранить сцену" Click="MenuSaveScene_Click"/>
                <MenuItem Header="Выход" Click="MenuExit_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Height="25" Focusable="True" MouseDown="ClearFocus_MouseDown">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готов к работе"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="RenderTimeText" Text="Время рендеринга: 0.0 с" Margin="0,0,10,0"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="220" />

                <ColumnDefinition />

                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>


            <Grid Grid.Column="0" Background="{StaticResource PanelBg}" Margin="0,0,2,0" Focusable="True" MouseDown="ClearFocus_MouseDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Иерархия сцены" FontWeight="Bold" FontSize="14" Margin="10,10,10,5" HorizontalAlignment="Center"/>

                <UniformGrid Grid.Row="1" Columns="2" Margin="5">
                    <Button x:Name="BtnAddObject" Content="Добавить" Click="BtnAddObject_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MenuAdd">
                                <MenuItem Header="Сфера" Click="MenuAddSphere_Click"/>
                                <MenuItem Header="Куб" Click="MenuAddCube_Click"/>
                                <MenuItem Header="Цилиндр" Click="MenuAddCylinder_Click"/>
                                <MenuItem Header="Направленный свет" Click="MenuAddDirLight_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="BtnRemoveObject" Content="Удалить" Click="MenuDelete_Click"/>
                </UniformGrid>

                <ListBox x:Name="SceneObjectsList" Grid.Row="2" Margin="10,5,10,10" 
                         PreviewMouseRightButtonDown="SceneObjectsList_PreviewMouseRightButtonDown"
                         SelectionChanged="SceneObjectsList_SelectionChanged">

                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Добавить Сферу" Click="MenuAddSphere_Click"/>
                            <MenuItem Header="Добавить Куб" Click="MenuAddCube_Click"/>
                            <MenuItem Header="Добавить Цилиндр" Click="MenuAddCylinder_Click"/>
                            <MenuItem Header="Добавить Направленный свет" Click="MenuAddDirLight_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <TextBlock x:Name="NameText" Text="{Binding Name}" Margin="0,2" Visibility="Visible"/>

                                <TextBox x:Name="NameInput" Text="{Binding Name, Mode=OneWay}" Visibility="Collapsed"
                                         KeyDown="NameInput_KeyDown" LostFocus="NameInput_LostFocus"/>

                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Переименовать" Click="MenuRename_Click"/>
                                        <MenuItem Header="Клонировать" Click="MenuClone_Click"/>
                                        <MenuItem Header="Удалить" Click="MenuDelete_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </Grid>

            <Border Grid.Column="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Focusable="True" MouseDown="ClearFocus_MouseDown">
                <glWpfControl:GLWpfControl x:Name="OpenGlControl" Render="OpenGlControl_Render" />
            </Border>

            <Grid Grid.Column="2" Background="{StaticResource DarkBg}" Margin="2,0,0,0" Focusable="True" MouseDown="ClearFocus_MouseDown">
                <TabControl>

                    <TabItem Header="Свойства" >
                        <StackPanel Margin="10">
                            <TextBlock Text="Настройки объекта" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                            <TextBlock Text="Координаты (X, Y, Z)"/>
                            <UniformGrid Columns="3" Margin="0,5,0,15">
                                <TextBox x:Name="PosX" Text="0.0" Margin="0,0,2,0" TextChanged="Properties_Changed"/>
                                <TextBox x:Name="PosY" Text="0.0" Margin="2,0,2,0" TextChanged="Properties_Changed"/>
                                <TextBox x:Name="PosZ" Text="0.0" Margin="2,0,0,0" TextChanged="Properties_Changed"/>
                            </UniformGrid>

                            <TextBlock x:Name="TxtRadius" Text="Радиус"/>
                            <TextBox x:Name="Radius" Text="1.0" Margin="0,0,2,0" TextChanged="Properties_Changed"/>

                            <TextBlock x:Name="TxtCubeSide" Text="Сторона"/>
                            <TextBox x:Name="Side" Text="1.0" Margin="0,0,2,0" TextChanged="Properties_Changed"/>

                            <TextBlock x:Name="TxtCylinderHeight" Text="Высота"/>
                            <TextBox x:Name="Height" Text="1.0" Margin="0,0,2,0" TextChanged="Properties_Changed"/>

                            <TextBlock Text="Цвет материала"/>
                            <Button x:Name="BtnSelectColor" Content="Выбрать цвет" Margin="0,5,0,15" Background="#880000" Click="BtnSelectColor_Click"/>

                            <UniformGrid Columns="2" Margin="0,5,0,15">
                                <TextBlock Text="Зеркальность:"/>
                                <TextBox x:Name="Reflectivity" Margin="0,0,2,0" TextChanged="Properties_Changed"/>
                            </UniformGrid>

                            <Slider x:Name="SliderReflectivity" Minimum="0" Maximum="1" Value="0.5" Margin="0,0,0,15" ValueChanged="Properties_Changed"/>

                            <TextBlock x:Name="TxtLightIntensity" Text="Интенсивность света"/>
                            <Slider x:Name="SliderLightIntensity" Minimum="0" Maximum="5" Value="1" Margin="0,5,0,15" ValueChanged="Properties_Changed"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Рендеринг">
                        <StackPanel Margin="10">
                            <TextBlock Text="Настройки рендеринга" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                            <TextBlock Text="Разрешение световой карты:"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                                <TextBox x:Name="ResX" Text="256" Width="50" HorizontalContentAlignment="Center"/>
                                <TextBlock Text=" x " VerticalAlignment="Center"/>
                                <TextBox x:Name="ResY" Text="256" Width="50" HorizontalContentAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Глубина трассировки (отражения): 3"/>
                            <Slider x:Name="SliderTraceDepth" Minimum="1" Maximum="10" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,5,0,25"/>

                            <Button x:Name="BtnRender" Content="Запустить рендер" FontWeight="Bold" FontSize="14" Padding="10" Background="#007ACC" BorderThickness="0"/>

                            <TextBlock Text="Предпросмотр световой карты" Margin="0,20,0,5" HorizontalAlignment="Center"/>
                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Width="220" Height="220" Background="{StaticResource DarkBg}">

                                <Image x:Name="LightmapPreviewImage" Stretch="Uniform"/>
                            </Border>
                        </StackPanel>
                    </TabItem>

                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>