<Window x:Class="RayTracer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RayTracer.Views"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        mc:Ignorable="d"
        Title="Трассировщик лучей" 
        Width="1280" Height="720" 
        MinWidth="1000" MinHeight="600" 
        FontFamily="Segoe UI"
        Background="{StaticResource WindowBg}"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">

    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="2">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть сцену" Click="MenuOpenScene_Click"/>
                <MenuItem Header="Сохранить сцену" Click="MenuSaveScene_Click"/>
                <MenuItem Header="Выход" Click="MenuExit_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Height="25" Focusable="True" MouseDown="ClearFocus_MouseDown">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готов к работе"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="RenderTimeText" Text="Время рендеринга: 0.0 с" Margin="0,0,10,0"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="220" />

                <ColumnDefinition />

                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>


            <Grid Grid.Column="0" Background="{StaticResource PanelBg}" Margin="0,0,2,0" Focusable="True" MouseDown="ClearFocus_MouseDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Иерархия сцены" FontWeight="Bold" FontSize="14" Margin="10,10,10,5" HorizontalAlignment="Center"/>

                <UniformGrid Grid.Row="1" Columns="2" Margin="5">
                    <Button x:Name="BtnAddObject" Content="Добавить" Click="BtnAddObject_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MenuAdd">
                                <MenuItem Header="Сфера" Click="MenuAddSphere_Click"/>
                                <MenuItem Header="Куб" Click="MenuAddCube_Click"/>
                                <MenuItem Header="Цилиндр" Click="MenuAddCylinder_Click"/>
                                <MenuItem Header="Глобальный свет" Click="MenuAddGlobalLight_Click"/>
                                <MenuItem Header="Направленный свет свет" Click="MenuAddSpotLight_Click"/>
                                <MenuItem Header="Точечный свет" Click="MenuAddPointLight_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="BtnRemoveObject" Content="Удалить" Click="MenuDelete_Click"/>
                </UniformGrid>

                <ListBox x:Name="SceneObjectsList" Grid.Row="2" Margin="10,5,10,10" 
                         PreviewMouseRightButtonDown="SceneObjectsList_PreviewMouseRightButtonDown"
                         SelectionChanged="SceneObjectsList_SelectionChanged">

                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Добавить Сферу" Click="MenuAddSphere_Click"/>
                            <MenuItem Header="Добавить Куб" Click="MenuAddCube_Click"/>
                            <MenuItem Header="Добавить Цилиндр" Click="MenuAddCylinder_Click"/>
                            <MenuItem Header="Добавить глобальный свет" Click="MenuAddGlobalLight_Click"/>
                            <MenuItem Header="Добавить направленный свет свет" Click="MenuAddSpotLight_Click"/>
                            <MenuItem Header="Добавить точечный свет" Click="MenuAddPointLight_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <TextBlock x:Name="NameText" Text="{Binding Name}" Margin="0,2" Visibility="Visible"/>

                                <TextBox x:Name="NameInput" Text="{Binding Name, Mode=OneWay}" Visibility="Collapsed"
                                         KeyDown="NameInput_KeyDown" LostFocus="NameInput_LostFocus"/>

                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Переименовать" Click="MenuRename_Click"/>
                                        <MenuItem Header="Клонировать" Click="MenuClone_Click"/>
                                        <MenuItem Header="Удалить" Click="MenuDelete_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </Grid>

            <Border Grid.Column="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Focusable="True" MouseDown="ClearFocus_MouseDown">
                <glWpfControl:GLWpfControl x:Name="OpenGlControl" Render="OpenGlControl_Render"
                                           MouseRightButtonDown="OpenGlControl_MouseRightButtonDown"
                                           MouseRightButtonUp="OpenGlControl_MouseRightButtonUp"
                                           MouseMove="OpenGlControl_MouseMove"/>
            </Border>

            <Grid Grid.Column="2" Background="{StaticResource DarkBg}" Margin="2,0,0,0" Focusable="True" MouseDown="ClearFocus_MouseDown">
                <TabControl>

                    <TabItem Header="Свойства">
                        <StackPanel x:Name="PropertiesContainer" Margin="10" Visibility="Hidden">

                            <TextBlock Text="Настройки объекта" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,15"/>
                            
                            <StackPanel x:Name="PanelCoordinates" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock Text="Координаты (X, Y, Z)"/>
                                <UniformGrid Columns="3" Margin="0,5,0,0">
                                    <TextBox x:Name="PosX" Text="0.0" Margin="0,0,2,0" TextChanged="Properties_Changed"/>
                                    <TextBox x:Name="PosY" Text="0.0" Margin="2,0,2,0" TextChanged="Properties_Changed"/>
                                    <TextBox x:Name="PosZ" Text="0.0" Margin="2,0,0,0" TextChanged="Properties_Changed"/>
                                </UniformGrid>
                            </StackPanel>

                            <StackPanel x:Name="PanelDirection" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock Text="Направление вектора (X, Y, Z)"/>
                                <UniformGrid Columns="3" Margin="0,5,0,0">
                                    <TextBox x:Name="DirX" Text="0.0" Margin="0,0,2,0" TextChanged="Properties_Changed"/>
                                    <TextBox x:Name="DirY" Text="-1.0" Margin="2,0,2,0" TextChanged="Properties_Changed"/>
                                    <TextBox x:Name="DirZ" Text="0.0" Margin="2,0,0,0" TextChanged="Properties_Changed"/>
                                </UniformGrid>
                            </StackPanel>

                            <StackPanel x:Name="PanelSpotAngle" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock Text="Угол конуса света (в градусах)"/>
                                <TextBox x:Name="SpotAngle" Text="30" TextChanged="Properties_Changed"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelSphere" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock Text="Радиус сферы"/>
                                <TextBox x:Name="Radius" Text="0.5" TextChanged="Properties_Changed"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelCube" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock Text="Сторона куба"/>
                                <TextBox x:Name="Side" Text="1.0" TextChanged="Properties_Changed"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelCylinder" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock Text="Радиус основания"/>
                                <TextBox x:Name="CylRadius" Text="0.5" Margin="0,0,0,5" TextChanged="Properties_Changed"/>
                                <TextBlock Text="Высота цилиндра"/>
                                <TextBox x:Name="Height" Text="1.0" TextChanged="Properties_Changed"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelColor" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock Text="Цвет"/>
                                <Button x:Name="BtnSelectColor" Content="Выбрать цвет" Margin="0,5,0,0" Click="BtnSelectColor_Click"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelMaterial" Visibility="Collapsed">
                                <TextBlock Text="Зеркальность:"/>
                                <Grid Margin="0,5,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SliderReflectivity" Minimum="0" Maximum="1" Value="0.5" ValueChanged="Properties_Changed" Margin="0,0,10,0"/>
                                    <TextBox x:Name="Reflectivity" Grid.Column="1" Text="0.5" TextChanged="Properties_Changed"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="PanelLight" Visibility="Collapsed">
                                <TextBlock Text="Интенсивность света"/>
                                <Slider x:Name="SliderLightIntensity" Minimum="0" Maximum="5" Value="1" Margin="0,5,0,15" ValueChanged="Properties_Changed"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelLightRange" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock Text="Дальность освещения"/>
                                <TextBox x:Name="LightRange" Text="10.0" TextChanged="Properties_Changed"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelCamera" Visibility="Collapsed">
                                <TextBlock Text="Угол обзора"/>
                                <TextBox x:Name="FOV" Text="60" TextChanged="Properties_Changed"/>
                            </StackPanel>

                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Рендеринг">
                        <StackPanel Margin="10">
                            <TextBlock Text="Настройки рендеринга" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                            <TextBlock Text="Разрешение световой карты:"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                                <TextBox x:Name="ResX" Text="256" Width="50" HorizontalContentAlignment="Center"/>
                                <TextBlock Text=" x " VerticalAlignment="Center"/>
                                <TextBox x:Name="ResY" Text="256" Width="50" HorizontalContentAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Глубина трассировки:"/>
                            <Grid Margin="0,5,0,15" Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SliderTraceDepth" Minimum="1" Maximum="10" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,5,0,0" ValueChanged="SliderTraceDepth_Changed"/>
                                <TextBox x:Name="TraceDepth" Grid.Column="1" Text="3" TextChanged="TraceDepth_Changed"/>
                            </Grid>
                            

                            <Button x:Name="BtnRender" Content="Запустить рендер" FontWeight="Bold" FontSize="14" Padding="10" Background="#007ACC" BorderThickness="0"/>

                            <TextBlock Text="Предпросмотр световой карты" Margin="0,20,0,5" HorizontalAlignment="Center"/>
                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Width="220" Height="220" Background="{StaticResource DarkBg}">

                                <Image x:Name="LightmapPreviewImage" Stretch="Uniform"
                                       Cursor="Hand" ToolTip="Нажмите для открытия в полном размере"
                                       MouseLeftButtonDown="LightmapPreviewImage_MouseLeftButtonDown"/>
                            </Border>
                        </StackPanel>
                    </TabItem>

                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>