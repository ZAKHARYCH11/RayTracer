<Window x:Class="RayTracer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RayTracer"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Левая колонка для меню (настроек) -->
            <ColumnDefinition Width="250" />
            <!-- Правая колонка для 3D сцены (занимает все оставшееся место) -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Панель управления (View) -->
        <StackPanel Grid.Column="0" Background="#ECECEC">
            <Label Content="Параметры рендера" FontWeight="Bold" Margin="5"/>
            <Button x:Name="BtnRender" Content="Запустить рендер" Margin="10" Padding="5"/>
        </StackPanel>

        <!-- Область предпросмотра OpenGL -->
        <glWpfControl:GLWpfControl 
        x:Name="OpenGlControl" 
        Grid.Column="1" 
        Render="OpenGlControl_Render" />

    </Grid>
</Window>
