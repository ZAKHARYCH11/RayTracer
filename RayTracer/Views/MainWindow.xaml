<Window x:Class="RayTracer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RayTracer.Views"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        mc:Ignorable="d"
        Title="Трассировщик лучей" 
        Height="720" Width="1280" 
        MinHeight="600" MinWidth="1000"
        FontFamily="Segoe UI"
        Background="#252526">

    <!-- Глобальные стили для темной темы -->
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#2D2D30"/>
        <SolidColorBrush x:Key="ElementBg" Color="#3E3E42"/>
        <SolidColorBrush x:Key="TextColor" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3F3F46"/>
        <SolidColorBrush x:Key="DarkBg" Color="#1E1E1E" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ElementBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource DarkBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource DarkBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        </Style>

        <!-- Исправленный стиль для TabControl -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource ElementBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" Margin="0,0,1,0">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header" 
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Триггер реагирует ТОЛЬКО на наведение на сам заголовок (HeaderBorder) -->
                            <Trigger Property="IsMouseOver" SourceName="HeaderBorder" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#4E4E52"/>
                            </Trigger>

                            <!-- IsSelected идет ПОСЛЕ наведения. Если вкладка выбрана, она остается темной (#2D2D30) -->
                            <!-- и игнорирует мышь -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource PanelBg}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Полностью переписанный стиль для Меню (убивает белые рамки и полосы) -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource PanelBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextColor}" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="{StaticResource PanelBg}" BorderThickness="0">
                            <Grid>
                                <ContentPresenter ContentSource="Header" Margin="10,5,15,5" RecognizesAccessKey="True" />
                                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
                                    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,0,5,5">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ElementBg}"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="Popup" Property="Placement" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource BorderColor}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
    </Window.Resources>

    <!-- DockPanel для привязки Меню наверх, а Статуса вниз -->
    <DockPanel>
        <!-- Верхнее меню -->
        <Menu DockPanel.Dock="Top" Padding="2">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть сцену"/>
                <MenuItem Header="Сохранить сцену"/>
                <Separator/>
                <MenuItem Header="Выход"/>
            </MenuItem>
        </Menu>

        <!-- Нижняя строка состояния -->
        <StatusBar DockPanel.Dock="Bottom" Background="#007ACC" Foreground="White" Height="25">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готов к работе"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="RenderTimeText" Text="Время рендеринга: 0.0 с" Margin="0,0,10,0"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Центральная часть программы (Сетка на 3 колонки) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Левая панель (Иерархия) -->
                <ColumnDefinition Width="220" />
                <!-- Центральная панель (3D) -->
                <ColumnDefinition />
                <!-- Правая панель (Настройки) -->
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <!-- ================= ЛЕВАЯ ПАНЕЛЬ ================= -->
            <Grid Grid.Column="0" Background="{StaticResource PanelBg}" Margin="0,0,2,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Заголовок -->
                    <RowDefinition Height="Auto"/>
                    <!-- Кнопки -->
                    <RowDefinition Height="*"/>
                    <!-- Список -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Иерархия сцены" FontWeight="Bold" FontSize="14" Margin="10,10,10,5" HorizontalAlignment="Center"/>

                <UniformGrid Grid.Row="1" Columns="2" Margin="5">
                    <Button x:Name="BtnAddObject" Content="Добавить"/>
                    <Button x:Name="BtnRemoveObject" Content="Удалить"/>
                </UniformGrid>

                <ListBox x:Name="SceneObjectsList" Grid.Row="2" Margin="10,5,10,10">
                    <!-- Заглушки для примера, потом будем добавлять из кода -->
                    <ListBoxItem Content="Камера"/>
                    <ListBoxItem Content="Солнце (Directional)"/>
                    <ListBoxItem Content="Сфера 1"/>
                    <ListBoxItem Content="Куб 1"/>
                </ListBox>
            </Grid>

            <!-- ================= ЦЕНТРАЛЬНАЯ ПАНЕЛЬ (3D Viewport) ================= -->
            <Border Grid.Column="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <glWpfControl:GLWpfControl x:Name="OpenGlControl" Render="OpenGlControl_Render" />
            </Border>

            <!-- ================= ПРАВАЯ ПАНЕЛЬ (Вкладки) ================= -->
            <Grid Grid.Column="2" Background="{StaticResource PanelBg}" Margin="2,0,0,0">
                <TabControl>

                    <!-- Вкладка 1: Свойства объекта -->
                    <TabItem Header="Свойства">
                        <StackPanel Margin="10">
                            <TextBlock Text="Настройки объекта" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                            <TextBlock Text="Координаты (X, Y, Z)"/>
                            <UniformGrid Columns="3" Margin="0,5,0,15">
                                <TextBox x:Name="PosX" Text="0.0" Margin="0,0,2,0"/>
                                <TextBox x:Name="PosY" Text="0.0" Margin="2,0,2,0"/>
                                <TextBox x:Name="PosZ" Text="0.0" Margin="2,0,0,0"/>
                            </UniformGrid>

                            <TextBlock Text="Цвет материала"/>
                            <Button x:Name="BtnSelectColor" Content="Выбрать цвет (R:255 G:0 B:0)" Margin="0,5,0,15" Background="#880000"/>

                            <TextBlock Text="Зеркальность: 0.5"/>
                            <Slider x:Name="SliderReflectivity" Minimum="0" Maximum="1" Value="0.5" Margin="0,5,0,15"/>

                            <TextBlock Text="Интенсивность света (если источник)"/>
                            <Slider x:Name="SliderLightIntensity" Minimum="0" Maximum="5" Value="1" Margin="0,5,0,15"/>
                        </StackPanel>
                    </TabItem>

                    <!-- Вкладка 2: Рендеринг -->
                    <TabItem Header="Рендеринг">
                        <StackPanel Margin="10">
                            <TextBlock Text="Настройки рендеринга" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                            <TextBlock Text="Разрешение световой карты:"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                                <TextBox x:Name="ResX" Text="256" Width="50" HorizontalContentAlignment="Center"/>
                                <TextBlock Text=" x " VerticalAlignment="Center"/>
                                <TextBox x:Name="ResY" Text="256" Width="50" HorizontalContentAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Глубина трассировки (отражения): 3"/>
                            <Slider x:Name="SliderTraceDepth" Minimum="1" Maximum="10" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,5,0,25"/>

                            <Button x:Name="BtnRender" Content="Запустить рендер" FontWeight="Bold" FontSize="14" Padding="10" Background="#007ACC" BorderThickness="0"/>

                            <TextBlock Text="Предпросмотр световой карты" Margin="0,20,0,5" HorizontalAlignment="Center"/>
                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Width="256" Height="256" Background="#1E1E1E">
                                <!-- Сюда мы будем выводить отрендеренную картинку -->
                                <Image x:Name="LightmapPreviewImage" Stretch="Uniform"/>
                            </Border>
                        </StackPanel>
                    </TabItem>

                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>