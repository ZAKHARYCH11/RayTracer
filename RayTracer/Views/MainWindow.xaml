<Window x:Class="RayTracer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RayTracer.Views"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        mc:Ignorable="d"
        Title="Трассировщик лучей" 
        Width="1280" Height="720" 
        MinWidth="1000" MinHeight="600" 
        FontFamily="Segoe UI"
        Background="{StaticResource WindowBg}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyUp="Window_KeyUp"
        Closing="Window_Closing">

    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="2">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть сцену" InputGestureText="Ctrl+O" Click="MenuOpenScene_Click"/>
                <MenuItem Header="Сохранить сцену" InputGestureText="Ctrl+S" Click="MenuSaveScene_Click"/>
                <MenuItem Header="Сохранить сцену как..." InputGestureText="Ctrl+Shift+S" Click="MenuSaveAsScene_Click"/>
                <Separator Background="{StaticResource SelectedBg}"/>
                <MenuItem Header="Выход" InputGestureText="Alt+F4" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="Руководство и горячие клавиши" InputGestureText="F1" Click="MenuHelp_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Height="25" Focusable="True" MouseDown="ClearFocus_MouseDown">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готов к работе"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="RenderTimeText" Text="Время рендеринга: 0.0 с" Margin="0,0,10,0"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="250" />

                <ColumnDefinition />

                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>


            <Grid Grid.Column="0" Background="{StaticResource PanelBg}" Margin="0,0,2,0"
                  Focusable="True"
                  MouseDown="ClearFocus_MouseDown"
                  MouseLeftButtonDown="Deselect_MouseLeftButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Иерархия сцены" FontWeight="Bold" FontSize="14" Margin="10,10,10,5" HorizontalAlignment="Center"/>

                <UniformGrid Grid.Row="1" Columns="2" Margin="5">
                    <Button x:Name="BtnAddObject" Content="Добавить" Click="BtnAddObject_Click" ToolTip="Открывает меню добавления объекта">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MenuAdd">
                                <MenuItem Header="Сфера" Click="MenuAddSphere_Click"/>
                                <MenuItem Header="Куб" Click="MenuAddCube_Click"/>
                                <MenuItem Header="Цилиндр" Click="MenuAddCylinder_Click"/>
                                <MenuItem Header="Глобальный свет" Click="MenuAddGlobalLight_Click"/>
                                <MenuItem Header="Направленный свет" Click="MenuAddSpotLight_Click"/>
                                <MenuItem Header="Точечный свет" Click="MenuAddPointLight_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="BtnRemoveObject" Content="Удалить" Click="MenuDelete_Click" ToolTip="Удаляет выбранный объект"/>
                </UniformGrid>

                <ListBox x:Name="SceneObjectsList" Grid.Row="2" Margin="10,5,10,10" 
                         ToolTip="ПКМ для открытия меню объектов"
                         PreviewMouseRightButtonDown="SceneObjectsList_PreviewMouseRightButtonDown"
                         PreviewMouseLeftButtonDown="SceneObjectsList_PreviewMouseLeftButtonDown"
                         SelectionChanged="SceneObjectsList_SelectionChanged">

                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Добавить Сферу" Click="MenuAddSphere_Click"/>
                            <MenuItem Header="Добавить Куб" Click="MenuAddCube_Click"/>
                            <MenuItem Header="Добавить Цилиндр" Click="MenuAddCylinder_Click"/>
                            <MenuItem Header="Добавить глобальный свет" Click="MenuAddGlobalLight_Click"/>
                            <MenuItem Header="Добавить направленный свет свет" Click="MenuAddSpotLight_Click"/>
                            <MenuItem Header="Добавить точечный свет" Click="MenuAddPointLight_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <TextBlock x:Name="NameText" Text="{Binding Name}" Margin="0,2" Visibility="Visible"/>

                                <TextBox x:Name="NameInput" Text="{Binding Name, Mode=OneWay}" Visibility="Collapsed"
                                         KeyDown="NameInput_KeyDown" LostFocus="NameInput_LostFocus"/>

                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Переименовать" Click="MenuRename_Click"/>
                                        <MenuItem Header="Клонировать" InputGestureText="Ctrl+D" Click="MenuClone_Click"/>
                                        <MenuItem Header="Удалить" InputGestureText="Del" Click="MenuDelete_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </Grid>

            <Border Grid.Column="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Focusable="True" MouseDown="ClearFocus_MouseDown">
                <glWpfControl:GLWpfControl x:Name="OpenGlControl" Render="OpenGlControl_Render"
                                           MouseLeftButtonDown="Deselect_MouseLeftButtonDown"
                                           MouseRightButtonDown="OpenGlControl_MouseRightButtonDown"
                                           MouseRightButtonUp="OpenGlControl_MouseRightButtonUp"
                                           MouseMove="OpenGlControl_MouseMove"/>
            </Border>

            <Grid Grid.Column="2" Background="{StaticResource DarkBg}" Margin="2,0,0,0" Focusable="True" MouseDown="ClearFocus_MouseDown">
                <TabControl>

                    <TabItem Header="Свойства">
                        <StackPanel x:Name="PropertiesContainer" Margin="10" Visibility="Hidden">

                            <TextBlock Text="Настройки объекта" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                            <TextBlock x:Name="TxtObjType" Text="Тип объекта: " Margin="0,0,0,15"/>

                            <StackPanel x:Name="PanelCoordinates" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock Text="Координаты"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblPosX" Grid.Column="0" Text="X" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" x:Name="PosX" Text="0.0" Margin="0,0,6,0" TextChanged="Properties_Changed"/>
                                    <TextBlock x:Name="LblPosY" Grid.Column="2" Text="Y" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="3" x:Name="PosY" Text="0.0" Margin="0,0,6,0" TextChanged="Properties_Changed"/>
                                    <TextBlock x:Name="LblPosZ" Grid.Column="4" Text="Z" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="5" x:Name="PosZ" Text="0.0" TextChanged="Properties_Changed"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="PanelDirection" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock Text="Поворот"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblRotX" Grid.Column="0" Text="X" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="Наклон вверх/вниз (Pitch)"/>
                                    <TextBox Grid.Column="1" x:Name="RotX" Text="0.0" Margin="0,0,8,0" TextChanged="Properties_Changed"/>
                                    <TextBlock x:Name="LblRotY" Grid.Column="2" Text="Y" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="Поворот влево/вправо (Yaw)"/>
                                    <TextBox Grid.Column="3" x:Name="RotY" Text="0.0" TextChanged="Properties_Changed"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="PanelSpotAngle" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock x:Name="LblSpotAngle" Text="Угол конуса света" HorizontalAlignment="Left"/>
                                <TextBox x:Name="SpotAngle" Text="30" TextChanged="Properties_Changed"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelSphere" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock x:Name="LblRadius" Text="Радиус сферы" HorizontalAlignment="Left"/>
                                <TextBox x:Name="Radius" Text="0.5" TextChanged="Properties_Changed"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelCube" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock x:Name="LblSide" Text="Сторона куба" HorizontalAlignment="Left"/>
                                <TextBox x:Name="Side" Text="1.0" TextChanged="Properties_Changed"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelCylinder" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock x:Name="LblCylRadius" Text="Радиус основания" HorizontalAlignment="Left"/>
                                <TextBox x:Name="CylRadius" Text="0.5" Margin="0,0,0,5" TextChanged="Properties_Changed"/>
                                <TextBlock x:Name="LblHeight" Text="Высота цилиндра" HorizontalAlignment="Left"/>
                                <TextBox x:Name="Height" Text="1.0" TextChanged="Properties_Changed"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelColor" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock x:Name="TxtColor" Text="Цвет: (R:255 G:255 B:255)"/>
                                <Button x:Name="BtnSelectColor" Content="" Margin="0,5,0,0" Click="BtnSelectColor_Click" ToolTip="Нажмите для выбора цвета" Style="{StaticResource NoMouseOverButtonStyle}"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelMaterial" Visibility="Collapsed">
                                <TextBlock x:Name="LblObjResolution" Text="Разрешение световой карты" HorizontalAlignment="Left"/>
                                <TextBox x:Name="ObjResolution" Text="256" Margin="0,5,0,15" TextChanged="Properties_Changed"/>

                                <TextBlock x:Name="LblReflectivity" Text="Зеркальность" HorizontalAlignment="Left"/>
                                <Grid Margin="0,5,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SliderReflectivity" Minimum="0" Maximum="1" Value="0.5" ValueChanged="Properties_Changed" Margin="0,5,10,0"/>
                                    <TextBox x:Name="Reflectivity" Grid.Column="1" Text="0.5" TextChanged="Properties_Changed"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="PanelLight" Visibility="Collapsed">
                                <TextBlock x:Name="LblLightIntensity" Text="Интенсивность света" HorizontalAlignment="Left"/>
                                <Grid Margin="0,5,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SliderLightIntensity" Minimum="0" Maximum="5" Value="1" Margin="0,5,10,0" ValueChanged="Properties_Changed"/>
                                    <TextBox x:Name="LightIntensity" Grid.Column="1" Text="1.0" TextChanged="Properties_Changed"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="PanelLightRange" Visibility="Collapsed" Margin="0,0,0,15">
                                <TextBlock x:Name="LblLightRange" Text="Дальность освещения" HorizontalAlignment="Left"/>
                                <TextBox x:Name="LightRange" Text="10.0" TextChanged="Properties_Changed"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelCamera" Visibility="Collapsed">
                                <TextBlock x:Name="LblFov" Text="Угол обзора" HorizontalAlignment="Left"/>
                                <TextBox x:Name="FOV" Text="75" TextChanged="Properties_Changed"/>
                            </StackPanel>

                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Рендеринг" Height="26" VerticalAlignment="Top">
                        <StackPanel Margin="10">
                            <TextBlock Text="Настройки рендеринга" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                            <TextBlock Text="Режим предпросмотра"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                                <RadioButton x:Name="RadioWireframe" Content="Каркас" IsChecked="True" Foreground="{StaticResource TextColor}" Margin="0,0,10,0" ToolTip="Отображение объектов линиями"/>
                                <RadioButton x:Name="RadioSolid" Content="Световые карты" Foreground="{StaticResource TextColor}" ToolTip="Отображение объектов с наложенными световыми картами"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <CheckBox x:Name="CheckGrid" Content="" IsChecked="True" HorizontalAlignment="Left" Foreground="{StaticResource TextColor}" ToolTip="Отображение сетки на нулевом Y"/>
                                <TextBlock Text="Сетка" ToolTip="Отображение сетки на нулевом Y"/>
                            </StackPanel>

                            <TextBlock Text="Глубина трассировки"/>
                            <Grid Margin="0,0,0,15" Height="28" ToolTip="Максимальное число переотражений луча">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SliderTraceDepth" Minimum="1" Maximum="10" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,5,0,0" ValueChanged="SliderTraceDepth_Changed"/>
                                <TextBox x:Name="TraceDepth" Grid.Column="1" Text="3"
                                         TextChanged="TraceDepth_Changed"
                                         LostFocus="TraceDepth_LostFocus"
                                         KeyDown="TraceDepth_KeyDown"
                                         GotKeyboardFocus="TraceDepth_GotKeyboardFocus"/>
                            </Grid>
                            

                            <Button x:Name="BtnRender" Content="Запустить рендер" FontWeight="Bold" FontSize="14" Padding="10" Background="#007ACC" BorderThickness="0" ToolTip="Запускает рендер световых карт всех объектов и отображает их (F5)"/>

                            <TextBlock Text="Предпросмотр световой карты" Margin="0,10,0,5" HorizontalAlignment="Center"/>
                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Width="270" Height="270" Background="{StaticResource DarkBg}">

                                <Image x:Name="LightmapPreviewImage" Stretch="Uniform"
                                       Cursor="Hand" ToolTip="Нажмите для открытия в полном размере"
                                       MouseLeftButtonDown="LightmapPreviewImage_MouseLeftButtonDown"/>
                            </Border>
                        </StackPanel>
                    </TabItem>

                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>